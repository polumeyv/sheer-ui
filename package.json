{
	"name": "sheer-ui",
	"version": "0.5.0",
	"description": "Svelte 5 UI component library with Tailwind CSS",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/polumeyv/sheer-ui.git"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*"
	],
	"publishConfig": {
		"access": "public"
	},
	"keywords": [
		"svelte",
		"ui",
		"components",
		"tailwind"
	],
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"scripts": {
		"dev": "bun --bun node_modules/.bin/vite dev --host 127.0.0.1 --port 4273 --strictPort",
		"build": "bunx --bun vite build",
		"preview": "bunx --bun vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "bun test && bun run test:components",
		"test:components": "svelte-kit sync && bunx vitest run --config vitest.config.ts",
		"changeset": "changeset",
		"changeset:version": "changeset version",
		"changeset:release": "changeset publish",
		"package": "svelte-kit sync && svelte-package && publint",
		"prepublishOnly": "bun run package"
	},
	"exports": {
		"./blocks": {
			"@polumeyv/source": "./src/lib/blocks/index.ts",
			"types": "./dist/blocks/index.d.ts",
			"svelte": "./dist/blocks/index.js",
			"default": "./dist/blocks/index.js"
		},
		"./blocks/*": {
			"@polumeyv/source": "./src/lib/blocks/*/index.ts",
			"types": "./dist/blocks/*/index.d.ts",
			"svelte": "./dist/blocks/*/index.js",
			"default": "./dist/blocks/*/index.js"
		},
		"./utils": {
			"@polumeyv/source": "./src/lib/internal/utils.ts",
			"types": "./dist/internal/utils.d.ts",
			"svelte": "./dist/internal/utils.js",
			"default": "./dist/internal/utils.js"
		},
		"./time": {
			"@polumeyv/source": "./src/lib/time.ts",
			"types": "./dist/time.d.ts",
			"svelte": "./dist/time.js",
			"default": "./dist/time.js"
		},
		"./icons/*": {
			"@polumeyv/source": {
				"types": "./src/lib/icons/icon.d.ts",
				"default": "./src/lib/icons/*"
			},
			"types": "./dist/icons/icon.d.ts",
			"svelte": "./dist/icons/*",
			"default": "./dist/icons/*"
		},
		"./styles": "./dist/assets/ui.css",
		"./components/*": {
			"@polumeyv/source": "./src/lib/components/*/index.ts",
			"types": "./dist/components/*/index.d.ts",
			"svelte": "./dist/components/*/index.js",
			"default": "./dist/components/*/index.js"
		},
		"./components/date-field": null,
		"./components/date-range-field": null,
		"./components/link-preview": null,
		"./components/meter": null,
		"./components/time-field": null,
		"./components/time-range-field": null
	},
	"peerDependencies": {
		"svelte": "^5.57.0",
		"@sveltejs/kit": "^3.0.0-next.25",
		"@internationalized/date": "^3.12.0"
	},
	"dependencies": {
		"@lucide/svelte": "^1.18.0",
		"esm-env": "^1.2.2",
		"d3-scale": "^4.0.2",
		"layerchart": "^2.0.1",
		"overrule": "^0.7.3"
	},
	"devDependencies": {
		"@changesets/changelog-github": "^1.0.0",
		"@changesets/cli": "^3.0.1",
		"@fontsource-variable/inter": "^5.2.8",
		"@internationalized/date": "^3.12.2",
		"@sveltejs/adapter-auto": "8.0.0-next.1",
		"@sveltejs/kit": "^3.0.0-next.25",
		"@sveltejs/package": "^3.0.0-next.8",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.2",
		"@types/bun": "^1.4.2",
		"@types/d3-chord": "^3.0.6",
		"@types/d3-delaunay": "^6.0.4",
		"@types/d3-force": "^3.0.10",
		"@types/d3-geo": "^3.1.0",
		"@types/d3-hierarchy": "^3.1.7",
		"@types/d3-sankey": "^0.12.5",
		"@types/d3-shape": "^3.1.8",
		"@types/d3-time": "^3.0.4",
		"handful": "^0.3.0",
		"jsdom": "^30.0.1",
		"publint": "^0.3.24",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.1",
		"tailwindcss": "^4.3.2",
		"typescript": "^6.0.3",
		"vite": "^8.2.1",
		"vitest": "^4.1.9"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}

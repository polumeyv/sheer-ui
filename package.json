{
	"name": "@polumeyv/ui",
	"version": "0.4.1",
	"description": "Svelte 5 UI component library with Tailwind CSS",
	"license": "MIT",
	"private": true,
	"keywords": [
		"svelte",
		"ui",
		"components",
		"tailwind"
	],
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"scripts": {
		"dev": "bun --bun node_modules/.bin/vite dev --host 127.0.0.1 --port 4273 --strictPort",
		"build": "bunx --bun vite build",
		"preview": "bunx --bun vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "bun test && bun run test:components",
		"test:components": "svelte-kit sync && bunx vitest run --config vitest.config.ts"
	},
	"exports": {
		"./blocks": {
			"types": "./src/lib/blocks/index.ts",
			"svelte": "./src/lib/blocks/index.ts",
			"default": "./src/lib/blocks/index.ts"
		},
		"./blocks/*": {
			"svelte": "./src/lib/blocks/*/index.ts",
			"default": "./src/lib/blocks/*/index.ts"
		},
		"./hooks": {
			"types": "./src/lib/hooks/index.ts",
			"svelte": "./src/lib/hooks/index.ts",
			"default": "./src/lib/hooks/index.ts"
		},
		"./utils": {
			"types": "./src/lib/internal/utils.ts",
			"svelte": "./src/lib/internal/utils.ts",
			"default": "./src/lib/internal/utils.ts"
		},
		"./time": {
			"types": "./src/lib/time.ts",
			"svelte": "./src/lib/time.ts",
			"default": "./src/lib/time.ts"
		},
		"./icons/*": {
			"types": "./src/lib/icons/icon.d.ts",
			"svelte": "./src/lib/icons/*",
			"default": "./src/lib/icons/*"
		},
		"./styles": "./src/lib/assets/ui.css",
		"./components/*": {
			"types": "./src/lib/components/*/index.ts",
			"svelte": "./src/lib/components/*/index.ts",
			"default": "./src/lib/components/*/index.ts"
		}
	},
	"peerDependencies": {
		"svelte": "^5.56.3",
		"@sveltejs/kit": "^3.0.0-next.0",
		"@internationalized/date": "^3.12.0"
	},
	"dependencies": {
		"@floating-ui/dom": "^1.7.1",
		"@lucide/svelte": "^1.18.0",
		"esm-env": "^1.2.2",
		"d3-scale": "^4.0.2",
		"layerchart": "^2.0.1",
		"overrule": "^0.7.1"
	},
	"devDependencies": {
		"@fontsource-variable/inter": "^5.2.8",
		"@sveltejs/adapter-auto": "8.0.0-next.1",
		"@internationalized/date": "^3.12.2",
		"@sveltejs/kit": "3.0.0-next.22",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.2",
		"tailwindcss": "^4.3.2",
		"@types/d3-chord": "^3.0.6",
		"@types/d3-delaunay": "^6.0.4",
		"@types/d3-force": "^3.0.10",
		"@types/d3-geo": "^3.1.0",
		"@types/d3-hierarchy": "^3.1.7",
		"@types/d3-sankey": "^0.12.5",
		"@types/d3-shape": "^3.1.8",
		"@types/d3-time": "^3.0.4",
		"@types/bun": "^1.3.14",
		"csstype": "^3.2.3",
		"jsdom": "^29.1.1",
		"svelte": "^5.56.3",
		"svelte-check": "^4.7.1",
		"typescript": "^6.0.3",
		"vite": "^8.2.1",
		"vitest": "^4.1.9"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}

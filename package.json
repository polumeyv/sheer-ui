{
	"name": "@polumeyv/ui",
	"version": "0.4.1",
	"description": "Svelte 5 UI component library with Tailwind CSS",
	"publishConfig": {
		"access": "public",
		"registry": "https://npm.pkg.github.com"
	},
	"license": "MIT",
	"keywords": [
		"svelte",
		"ui",
		"components",
		"tailwind"
	],
	"type": "module",
	"repository": "github:polumeyv/ui-lib",
	"sideEffects": [
		"**/*.css"
	],
	"scripts": {
		"dev": "bunx --bun vite dev",
		"build": "bunx --bun vite build && bun run prepack",
		"preview": "bunx --bun vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "bunx --bun svelte-kit sync && bunx --bun svelte-package && bunx publint",
		"package:watch": "bunx svelte-kit sync && bunx svelte-package -w -p",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "bun test"
	},
	"bin": {
		"ui": "./bin/init.mjs"
	},
	"files": [
		"dist",
		"bin",
		"src/lib",
		"!src/lib/**/*.test.*",
		"!src/lib/**/*.spec.*"
	],

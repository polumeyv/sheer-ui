{
	"name": "@polumeyv/ui",
	"version": "0.4.1",
	"description": "Svelte 5 UI component library with Tailwind CSS",
	"publishConfig": {
		"access": "public",
		"registry": "https://npm.pkg.github.com"
	},
	"license": "MIT",
	"keywords": [
		"svelte",
		"ui",
		"components",
		"tailwind"
	],
	"type": "module",
	"repository": "github:polumeyv/ui-lib",
	"sideEffects": [
		"**/*.css"
	],
	"scripts": {
		"registry:build": "bun scripts/build-registry.ts",
		"dev": "bun run registry:build && bunx --bun vite dev --host 127.0.0.1 --port 4273 --strictPort",
		"build": "bun run registry:build && bunx --bun vite build && bun run prepack",
		"preview": "bunx --bun vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "bun run registry:build && bunx --bun svelte-kit sync && bunx --bun svelte-package && bunx publint",
		"package:watch": "bun run registry:build && bunx svelte-kit sync && bunx svelte-package -w -p",
		"check": "bun run registry:build && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "bun test",
		"test:components": "bun run registry:build && svelte-kit sync && bunx vitest run --config vitest.config.ts"
	},
	"files": [
		"dist",
		"src/lib",
		"!src/lib/registry/*.svelte",
		"!src/lib/**/*.test.*",
		"!src/lib/**/*.spec.*"
	],

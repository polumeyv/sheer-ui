{
	"extends": "./.svelte-kit/tsconfig.json",
	"compilerOptions": {
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"forceConsistentCasingInFileNames": true,
		"noEmit": true,
		"lib": ["esnext", "DOM", "DOM.Iterable"],
		"moduleResolution": "bundler",
		"skipLibCheck": true,
		"module": "esnext",
		"target": "esnext",
		"types": ["bun"],
		"strict": true,
		// Inherit base's plugins/options, but keep this component lib's prior strictness profile:
		// base enables noUncheckedIndexedAccess + noImplicitOverride, which the vendored
		// upstream bits-ui code isn't written for (it omits `override` modifiers).
		"noUncheckedIndexedAccess": false,
		"noImplicitOverride": false
	},
	"include": ["src/lib"],
	"exclude": ["dist", "src/lib/registry/*.svelte"]
}

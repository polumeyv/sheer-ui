{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"forceConsistentCasingInFileNames": true,
		"noEmit": true,
		"lib": ["esnext", "DOM", "DOM.Iterable"],
		"moduleResolution": "bundler",
		"skipLibCheck": true,
		"module": "esnext",
		"target": "esnext",
		// `include` below replaces the generated one, so `.svelte-kit/ambient.d.ts` — which references these — is out of the program.
		"types": ["bun", "@sveltejs/kit", "$app/types"],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		// Carried from the monorepo base tsconfig, which a standalone checkout cannot reach:
		// `allowJs` types the one non-TS component (theme-toggle.svelte).
		"allowJs": true,
		"noFallthroughCasesInSwitch": true
	},
	"include": ["src/lib"],
	"exclude": ["src/lib/registry/*.svelte"]
}
